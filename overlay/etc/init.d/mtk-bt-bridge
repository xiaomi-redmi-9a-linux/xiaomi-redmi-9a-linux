#!/sbin/openrc-run

name="MediaTek Bluetooth VHCI Bridge"
description="Bridges /dev/vhci to /dev/stpbt for native BlueZ Bluetooth (Rust daemon)"
command="/usr/local/bin/mtk-bt-bridge"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
	need mtk-wmt-loader
	before bluetooth
}

start_post() {
	ebegin "Waiting for Bluetooth controller (hci0) to register"
	for i in $(seq 1 20); do
		if [ -d /sys/class/bluetooth/hci0 ]; then
			eend 0
			return 0
		fi
		sleep 0.2
	done
	eend 1 "hci0 did not appear within 4 seconds"
	return 1
}
